# Iris Geofenced Attendance System — Environment Configuration Template
# Copy this file or supply values via --dart-define when building/running.
# NEVER commit your real service role keys or production secrets to Git.

# Environment: dev, staging, prod
ENV=dev

# Backend API endpoint
API_BASE_URL=https://api-dev.irisattendance.edu/v1

# Supabase Auth & Database (Leave empty or set to valid project URL for live backend)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Campus Geofencing Center Coordinates (VNR VJIET Bachupally Campus)
CAMPUS_LAT=17.538500
CAMPUS_LNG=78.385200
GEOFENCE_RADIUS_METERS=350.0

# Edge Biometric Iris Engine specification
IRIS_ENGINE_VERSION=v2.4-edge
